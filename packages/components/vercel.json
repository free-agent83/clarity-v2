{
  "buildCommand": "cd ../.. && npx nx run components:build-storybook",
  "outputDirectory": "storybook-static",
  "installCommand": "cd ../.. && npm install",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
