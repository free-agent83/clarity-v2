{
  "name": "@nivoda/components",
  "version": "0.0.1",
  "private": true,
  "description": "Nivoda component library — shadcn/ui + Radix UI + Tailwind CSS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web-theme.css": "./dist/styles/web-theme.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:storybook": "vitest run --project=storybook --passWithNoTests"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@tabler/icons-react": "^3.40.0",
    "lucide-react": "^0.500.0",
    "next-themes": "^0.4.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/experimental-addon-test": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "8.6.18",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/browser": "^3.2.4",
    "glob": "^13.0.6",
    "playwright": "^1.59.1",
    "recharts": "^3.0.0",
    "rollup-preserve-directives": "^1.1.3",
    "storybook": "8.6.18",
    "tailwindcss": "^4.1.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
