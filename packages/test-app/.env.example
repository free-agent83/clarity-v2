# ---------------------------------------------------------------------------
# Auth (JWT-based, no database required)
# ---------------------------------------------------------------------------

# Credentials for the hardcoded demo login
AUTH_USERNAME=demo@minivoda.test
AUTH_PASSWORD=demo

# Secret used to sign/verify JWT cookies. Change this in any shared env.
# Must be at least 32 characters for production use.
JWT_SECRET=dev-secret-not-for-production

# ---------------------------------------------------------------------------
# Optional: artificial latency for demo/dev
# ---------------------------------------------------------------------------

# DEMO_LATENCY_MIN_MS=80
# DEMO_LATENCY_MAX_MS=320
